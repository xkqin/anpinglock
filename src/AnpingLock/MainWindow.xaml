<Window x:Class="AnpingLock.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="安屏 AnpingLock" Width="980" Height="800" MinWidth="920" MinHeight="760"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize"
        Background="#0B1020" Foreground="#EDF2FF" FontFamily="Segoe UI, Microsoft YaHei UI"
        Icon="Assets/AnpingLock.ico" Closing="OnClosing" Loaded="OnLoaded">
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6" CornerRadius="14" GlassFrameThickness="0" />
  </shell:WindowChrome.WindowChrome>
  <Window.Resources>
    <Style x:Key="Card" TargetType="Border">
      <Setter Property="Background" Value="#111A2D" />
      <Setter Property="BorderBrush" Value="#23304A" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="13" />
    </Style>
    <Style x:Key="Eyebrow" TargetType="TextBlock">
      <Setter Property="Foreground" Value="#8296BB" />
      <Setter Property="FontSize" Value="10" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Margin" Value="0,0,0,8" />
    </Style>
    <Style TargetType="ComboBoxItem">
      <Setter Property="Foreground" Value="#EDF2FF" />
      <Setter Property="Background" Value="#18243C" />
      <Setter Property="Padding" Value="10,8" />
    </Style>
    <Style TargetType="ComboBox">
      <Setter Property="Foreground" Value="#EDF2FF" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBox">
            <Grid>
              <ToggleButton Focusable="False" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                <ToggleButton.Template>
                  <ControlTemplate TargetType="ToggleButton">
                    <Border Background="#18243C" BorderBrush="#34486D" BorderThickness="1" CornerRadius="8">
                      <Path Data="M 0 0 L 5 5 L 10 0" Stroke="#9AB1D6" StrokeThickness="1.5" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,14,0" />
                    </Border>
                  </ControlTemplate>
                </ToggleButton.Template>
              </ToggleButton>
              <ContentPresenter Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                Margin="12,0,36,0" HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False" />
              <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                <Border Background="#18243C" BorderBrush="#34486D" BorderThickness="1" CornerRadius="8" Padding="4"
                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                  <ScrollViewer MaxHeight="240"><ItemsPresenter /></ScrollViewer>
                </Border>
              </Popup>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>
  <Border Background="#0B1020" BorderBrush="#28354F" BorderThickness="1" CornerRadius="13" Padding="26,15,26,14">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="51" /><RowDefinition Height="77" /><RowDefinition Height="147" />
        <RowDefinition Height="85" /><RowDefinition Height="*" /><RowDefinition Height="97" /><RowDefinition Height="28" />
      </Grid.RowDefinitions>
      <Grid Grid.Row="0" MouseLeftButtonDown="OnDragHeader">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Top">
          <Image Source="Assets/AnpingLock.ico" Width="34" Height="34" Margin="0,0,11,0" />
          <StackPanel>
            <TextBlock x:Name="AppNameText" Text="安屏 AnpingLock" FontSize="18" FontWeight="SemiBold" />
            <TextBlock x:Name="TaglineText" FontSize="10" Foreground="#8396BA" />
          </StackPanel>
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
          <Button x:Name="LanguageButton" Content="EN" Click="OnLanguage" Padding="10,6" Margin="0,0,13,0" />
          <Button Content="—" Click="OnMinimize" Background="Transparent" BorderThickness="0" Padding="10,6" />
          <Button Content="✕" Click="OnClose" Background="Transparent" BorderThickness="0" Padding="10,6" Margin="3,0,0,0" />
        </StackPanel>
      </Grid>

      <StackPanel Grid.Row="1" Margin="0,2,0,0">
        <TextBlock x:Name="HeadingText" FontSize="25" FontWeight="SemiBold" />
        <TextBlock x:Name="IntroText" FontSize="12" Foreground="#91A2C2" Margin="0,9,0,0" />
      </StackPanel>

      <Border Grid.Row="2" CornerRadius="15" BorderBrush="#355180" BorderThickness="1" Padding="22,18">
        <Border.Background>
          <LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#1C345A" Offset="0" /><GradientStop Color="#141D33" Offset="1" /></LinearGradientBrush>
        </Border.Background>
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="106" /></Grid.ColumnDefinitions>
          <StackPanel VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
              <Ellipse x:Name="StatusDot" Fill="#83B4FF" Width="7" Height="7" VerticalAlignment="Center" Margin="0,0,8,0" />
              <TextBlock x:Name="AppRunningText" FontSize="10" FontWeight="SemiBold" Foreground="#B6D0FA" />
            </StackPanel>
            <TextBlock x:Name="StateTitleText" FontSize="25" FontWeight="SemiBold" />
            <TextBlock x:Name="StateBodyText" FontSize="12" Foreground="#B4C4DF" Margin="0,9,14,0" TextWrapping="Wrap" MaxWidth="680" HorizontalAlignment="Left" />
          </StackPanel>
          <Border Grid.Column="1" Width="85" Height="85" Background="#243F69" BorderBrush="#416294" BorderThickness="1" CornerRadius="24" HorizontalAlignment="Right" VerticalAlignment="Center">
            <TextBlock Text="&#xE702;" FontFamily="Segoe MDL2 Assets" FontSize="43" Foreground="#9BC8FF" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
        </Grid>
      </Border>

      <Grid Grid.Row="3" Margin="0,13,0,0">
        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="12" /><ColumnDefinition /><ColumnDefinition Width="12" /><ColumnDefinition /></Grid.ColumnDefinitions>
        <Border Grid.Column="0" Style="{StaticResource Card}" Padding="15,10">
          <StackPanel><TextBlock x:Name="CheckedLabel" Style="{StaticResource Eyebrow}" Margin="0,0,0,4" /><TextBlock x:Name="CheckedValue" Text="—" FontSize="18" /></StackPanel>
        </Border>
        <Border Grid.Column="2" Style="{StaticResource Card}" Padding="15,10">
          <StackPanel><TextBlock x:Name="RequestsLabel" Style="{StaticResource Eyebrow}" Margin="0,0,0,4" /><TextBlock x:Name="RequestsValue" Text="0" FontSize="18" /></StackPanel>
        </Border>
        <Border Grid.Column="4" Style="{StaticResource Card}" Padding="15,10">
          <StackPanel><TextBlock x:Name="IntervalLabel" Style="{StaticResource Eyebrow}" Margin="0,0,0,4" /><TextBlock x:Name="IntervalValue" FontSize="18" /></StackPanel>
        </Border>
      </Grid>

      <Grid Grid.Row="4" Margin="0,13,0,0">
        <Grid.ColumnDefinitions><ColumnDefinition Width="1.17*" /><ColumnDefinition Width="13" /><ColumnDefinition /></Grid.ColumnDefinitions>
        <Border Style="{StaticResource Card}" Padding="18,15">
          <StackPanel>
            <TextBlock x:Name="DeviceLabel" Style="{StaticResource Eyebrow}" />
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="9" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
              <Grid>
                <ComboBox x:Name="DeviceCombo" DisplayMemberPath="Name" SelectedValuePath="Address" Height="39" SelectionChanged="OnDeviceChanged" AutomationProperties.Name="Paired Bluetooth device" />
                <TextBlock x:Name="DevicePlaceholder" Margin="12,0,33,0" Foreground="#8DA0C2" FontSize="11" VerticalAlignment="Center" IsHitTestVisible="False" TextTrimming="CharacterEllipsis" />
              </Grid>
              <Button x:Name="RefreshButton" Grid.Column="2" Click="OnRefresh" Padding="12,8" />
            </Grid>
            <Button x:Name="StartButton" Click="OnStartStop" Background="#477CF5" BorderBrush="#6A99FF" FontWeight="SemiBold" Margin="0,12,0,0" Padding="14,10" />
            <TextBlock x:Name="StartupText" Foreground="#A3C9BD" FontSize="11" Margin="0,14,0,0" TextWrapping="Wrap" />
            <Button x:Name="BluetoothSettingsButton" Click="OnBluetoothSettings" Background="Transparent" BorderThickness="0" Foreground="#8EB8FF" FontSize="11" HorizontalAlignment="Left" Padding="0,9,0,0" />
          </StackPanel>
        </Border>
        <Border Grid.Column="2" Style="{StaticResource Card}" Padding="18,15">
          <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition /></Grid.RowDefinitions>
            <TextBlock x:Name="ActivityLabel" Style="{StaticResource Eyebrow}" />
            <TextBlock x:Name="ActivityEmptyText" Grid.Row="1" FontSize="11" Foreground="#7B90B4" TextWrapping="Wrap" Margin="0,7,0,0" />
            <ListBox x:Name="ActivityList" Grid.Row="1" BorderThickness="0" Background="Transparent" Foreground="#A8B8D5" FontSize="11" Padding="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
              <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Padding" Value="0,5" /><Setter Property="Focusable" Value="False" /><Setter Property="HorizontalContentAlignment" Value="Stretch" /></Style></ListBox.ItemContainerStyle>
              <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" Foreground="#A8B8D5" FontSize="11" /></DataTemplate></ListBox.ItemTemplate>
            </ListBox>
          </Grid>
        </Border>
      </Grid>

      <Border Grid.Row="5" Style="{StaticResource Card}" Margin="0,13,0,0" Padding="16,11">
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
          <StackPanel VerticalAlignment="Center" Margin="0,0,18,0">
            <TextBlock x:Name="DynamicTitle" FontSize="12" FontWeight="SemiBold" />
            <TextBlock x:Name="DynamicBody" FontSize="10" Foreground="#8FA2C3" TextWrapping="Wrap" Margin="0,5,0,0" />
          </StackPanel>
          <Button x:Name="DynamicButton" Grid.Column="1" Click="OnDynamicLockSettings" VerticalAlignment="Center" FontSize="11" Padding="12,9" />
        </Grid>
      </Border>
      <TextBlock Grid.Row="6" x:Name="FooterText" FontSize="10" Foreground="#657B9F" VerticalAlignment="Bottom" />
    </Grid>
  </Border>
</Window>
